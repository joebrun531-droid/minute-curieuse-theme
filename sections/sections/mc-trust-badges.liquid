{% comment %}
  Section : Barre "Objets choisis / Paiement sécurisé / Livraison / Service client"
  À placer dans /sections/mc-trust-badges.liquid
{% endcomment %}

<div class="mc-trust">
  <div class="mc-trust__inner">
    {% for block in section.blocks %}
      <div class="mc-trust__item" {{ block.shopify_attributes }}>
        <span class="mc-trust__icon">{{ block.settings.icon }}</span>
        <div>
          <strong>{{ block.settings.title }}</strong>
          <p>{{ block.settings.subtitle }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .mc-trust { background: #171310; padding: 28px 5vw; border-top: 1px solid #2a241d; }
  .mc-trust__inner {
    max-width: 1400px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
  }
  .mc-trust__item { display: flex; align-items: center; gap: 14px; color: #e9dfc9; }
  .mc-trust__icon {
    width: 44px; height: 44px; min-width: 44px;
    border: 1px solid #d4a64a; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #d4a64a;
  }
  .mc-trust__item strong { display: block; font-size: 14px; text-transform: uppercase; letter-spacing: 0.03em; }
  .mc-trust__item p { margin: 2px 0 0; font-size: 13px; color: #a99b80; }
  @media (max-width: 900px) {
    .mc-trust__inner { grid-template-columns: 1fr 1fr; }
  }
</style>

{% schema %}
{
  "name": "MC - Barre de confiance",
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icône (emoji)", "default": "✦" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Objets choisis" },
        { "type": "text", "id": "subtitle", "label": "Sous-texte", "default": "avec passion" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "icon": "✦", "title": "Objets choisis", "subtitle": "avec passion" } },
      { "type": "item", "settings": { "icon": "🛡", "title": "Paiement sécurisé", "subtitle": "100% sécurisé" } },
      { "type": "item", "settings": { "icon": "🚚", "title": "Livraison suivie", "subtitle": "dès 50€ d'achat" } },
      { "type": "item", "settings": { "icon": "🎧", "title": "Service client 7/7", "subtitle": "réponse rapide" } }
    ]
  },
  "presets": [
    { "name": "MC - Barre de confiance" }
  ]
}
{% endschema %}
