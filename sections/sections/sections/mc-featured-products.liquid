{% comment %}
  Section : Grille produits "Nos objets les plus populaires"
  Connectée à une vraie collection Shopify.
  À placer dans /sections/mc-featured-products.liquid
{% endcomment %}

<section class="mc-products">
  <h2 class="mc-products__title">{{ section.settings.heading | default: "Nos objets les plus populaires" }}</h2>
  <div class="mc-products__divider">★</div>

  <div class="mc-products__grid">
    {% assign coll = collections[section.settings.collection] %}
    {% for product in coll.products limit: section.settings.products_to_show %}
      <div class="mc-product-card">
        <a href="{{ product.url }}" class="mc-product-card__image">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {% endif %}
          {% if product.compare_at_price > product.price %}
            <span class="mc-product-card__badge">PROMO</span>
          {% endif %}
        </a>
        <div class="mc-product-card__body">
          <a href="{{ product.url }}" class="mc-product-card__name">{{ product.title }}</a>
          <div class="mc-product-card__price">
            <span class="mc-price">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="mc-price-compare">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>
          {% form 'product', product %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="mc-product-card__cart">🛒</button>
          {% endform %}
        </div>
      </div>
    {% else %}
      <p class="mc-products__empty">Choisis une collection dans les réglages de section pour afficher tes produits ici.</p>
    {% endfor %}
  </div>

  {% if section.settings.button_link %}
    <div class="mc-products__cta-wrap">
      <a href="{{ section.settings.button_link }}" class="mc-products__cta">
        {{ section.settings.button_text | default: "VOIR TOUS LES PRODUITS" }} ›
      </a>
    </div>
  {% endif %}
</section>

<style>
  .mc-products { background: #171310; color: #f5ecd9; padding: 60px 5vw; text-align: center; }
  .mc-products__title { font-family: Georgia, serif; font-size: 24px; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 6px; }
  .mc-products__divider { color: #d4a64a; margin-bottom: 32px; }
  .mc-products__grid {
    max-width: 1400px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px;
    text-align: left;
  }
  .mc-product-card { background: #1e1913; border: 1px solid #2a241d; border-radius: 4px; overflow: hidden; }
  .mc-product-card__image { display: block; position: relative; aspect-ratio: 1/1; overflow: hidden; }
  .mc-product-card__image img { width: 100%; height: 100%; object-fit: cover; }
  .mc-product-card__badge {
    position: absolute; top: 8px; left: 8px;
    background: #d4a64a; color: #171310; font-size: 10px; font-weight: 700;
    padding: 3px 8px; border-radius: 2px; text-transform: uppercase;
  }
  .mc-product-card__body { padding: 12px; }
  .mc-product-card__name {
    display: block; color: #f5ecd9; text-decoration: none; font-size: 13px;
    margin-bottom: 8px; min-height: 34px; line-height: 1.3;
  }
  .mc-product-card__price { display: flex; align-items: baseline; gap: 8px; justify-content: space-between; }
  .mc-price { color: #d4a64a; font-weight: 700; }
  .mc-price-compare { text-decoration: line-through; color: #7a6e58; font-size: 12px; }
  .mc-product-card__cart {
    background: none; border: 1px solid #d4a64a; color: #d4a64a;
    border-radius: 3px; padding: 4px 8px; cursor: pointer; margin-top: 8px;
  }
  .mc-products__cta-wrap { margin-top: 36px; }
  .mc-products__cta {
    display: inline-block; border: 1px solid #d4a64a; color: #f5ecd9;
    text-decoration: none; padding: 12px 24px; font-size: 13px; letter-spacing: 0.06em;
  }
  .mc-products__empty { grid-column: 1 / -1; color: #a99b80; }
  @media (max-width: 1100px) { .mc-products__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .mc-products__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{
  "name": "MC - Produits populaires",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos objets les plus populaires" },
    { "type": "collection", "id": "collection", "label": "Collection à afficher" },
    { "type": "range", "id": "products_to_show", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "button_text", "label": "Texte du bouton", "default": "VOIR TOUS LES PRODUITS" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "presets": [
    { "name": "MC - Produits populaires" }
  ]
}
{% endschema %}
