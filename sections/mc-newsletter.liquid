{% comment %}
  Section : "Rejoins la communauté des curieux" (inscription newsletter)
  Utilise le formulaire natif Shopify "customer".
  À placer dans /sections/mc-newsletter.liquid
{% endcomment %}

<section class="mc-newsletter">
  <div class="mc-newsletter__inner">
    <div class="mc-newsletter__text">
      <h2>{{ section.settings.heading | default: "Rejoins la communauté des curieux !" }}</h2>
      <p>{{ section.settings.subtitle | default: "Des anecdotes, des objets rares et des histoires fascinantes, directement dans ta boîte mail." }}</p>
    </div>
    <div class="mc-newsletter__form">
      {% form 'customer' %}
        {% if form.posted_successfully? %}
          <p class="mc-newsletter__success">Merci, ton inscription est confirmée !</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="mc-newsletter__row">
            <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'Ton email' }}" required>
            <button type="submit">{{ section.settings.button_text | default: "S'INSCRIRE" }}</button>
          </div>
          <p class="mc-newsletter__note">🔒 {{ section.settings.note | default: "Aucune publicité, seulement du contenu de qualité." }}</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

<style>
  .mc-newsletter { background: #1a140d; padding: 50px 5vw; }
  .mc-newsletter__inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center;
  }
  .mc-newsletter h2 { font-family: Georgia, serif; color: #f5ecd9; font-size: 24px; margin: 0 0 10px; }
  .mc-newsletter p { color: #b8ab94; font-size: 14px; margin: 0; }
  .mc-newsletter__row { display: flex; gap: 10px; }
  .mc-newsletter__row input {
    flex: 1; padding: 12px 14px; background: transparent; border: 1px solid #4a3f2c;
    color: #f5ecd9; border-radius: 2px;
  }
  .mc-newsletter__row button {
    background: #d4a64a; color: #171310; border: none; font-weight: 700;
    padding: 12px 22px; border-radius: 2px; cursor: pointer; text-transform: uppercase; font-size: 13px;
  }
  .mc-newsletter__note { margin-top: 10px; font-size: 12px; color: #8a7a5c; }
  .mc-newsletter__success { color: #d4a64a; font-weight: 600; }
  @media (max-width: 800px) {
    .mc-newsletter__inner { grid-template-columns: 1fr; }
    .mc-newsletter__row { flex-direction: column; }
  }
</style>

{% schema %}
{
  "name": "MC - Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Rejoins la communauté des curieux !" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-texte" },
    { "type": "text", "id": "placeholder", "label": "Placeholder champ email", "default": "Ton email" },
    { "type": "text", "id": "button_text", "label": "Texte bouton", "default": "S'INSCRIRE" },
    { "type": "text", "id": "note", "label": "Note sous le formulaire", "default": "Aucune publicité, seulement du contenu de qualité." }
  ],
  "presets": [
    { "name": "MC - Newsletter" }
  ]
}
{% endschema %}
