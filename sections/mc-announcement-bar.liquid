{% comment %}
  Section : Barre d'annonce (bandeau doré en haut)
  À placer dans /sections/mc-announcement-bar.liquid
{% endcomment %}

<div class="mc-announcement-bar">
  <p>{{ section.settings.announcement_text | default: "🚚 LIVRAISON OFFERTE DÈS 50€ D'ACHAT" }}</p>
</div>

<style>
  .mc-announcement-bar {
    background: linear-gradient(90deg, #8a6d1f, #b8912f, #8a6d1f);
    color: #fff8ea;
    text-align: center;
    padding: 8px 16px;
    font-size: 13px;
    letter-spacing: 0.08em;
    font-weight: 600;
    text-transform: uppercase;
  }
  .mc-announcement-bar p { margin: 0; }
</style>

{% schema %}
{
  "name": "MC - Barre d'annonce",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texte de la barre",
      "default": "🚚 LIVRAISON OFFERTE DÈS 50€ D'ACHAT"
    }
  ],
  "presets": [
    { "name": "MC - Barre d'annonce" }
  ]
}
{% endschema %}
